+
+// A Vulkan context for an embedding app that owns its CAMetalLayer and passes
+// the layer's address as --wid. Used where there is no Cocoa, such as tvOS.
+
+#import <QuartzCore/QuartzCore.h>
+
+#include "video/out/gpu/context.h"
+
+#include "common.h"
+#include "context.h"
+#include "utils.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+};
+
+static CAMetalLayer *metal_layer(struct ra_ctx *ctx)
+{
+    return (__bridge CAMetalLayer *)(void *)(intptr_t)ctx->vo->opts->WinID;
+}
+
+static void moltenvk_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+}
+
+static bool moltenvk_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    if (ctx->vo->opts->WinID == -1) {
+        MP_MSG(ctx, msgl, "No --wid set, which has to be a CAMetalLayer\n");
+        goto error;
+    }
+
+    if (!mpvk_init(vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME))
+        goto error;
+
+    VkMetalSurfaceCreateInfoEXT info = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pLayer = metal_layer(ctx),
+    };
+
+    VkInstance inst = vk->vkinst->instance;
+    VkResult res = vkCreateMetalSurfaceEXT(inst, &info, NULL, &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_MSG(ctx, msgl, "Failed creating metal surface\n");
+        goto error;
+    }
+
+    struct ra_ctx_params params = {0};
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
+        goto error;
+
+    return true;
+error:
+    moltenvk_uninit(ctx);
+    return false;
+}
+
+static bool moltenvk_reconfig(struct ra_ctx *ctx)
+{
+    CGSize size = metal_layer(ctx).drawableSize;
+    return ra_vk_ctx_resize(ctx, (int)size.width, (int)size.height);
+}
+
+static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_moltenvk = {
+    .type        = "vulkan",
+    .name        = "moltenvk",
+    .description = "Vulkan through MoltenVK, on a CAMetalLayer given as --wid",
+    .reconfig    = moltenvk_reconfig,
+    .control     = moltenvk_control,
+    .init        = moltenvk_init,
+    .uninit      = moltenvk_uninit,
+};

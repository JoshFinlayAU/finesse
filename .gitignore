# Secrets and credentials. Test credentials live only in .env.local, which is never committed.
.env
.env.*
*.p8
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
*.pem
*.key
id_rsa*
id_ed25519*
secrets/
ssh_keys/

# Build output and test results, which can hold credentials and screen recordings.
build/
DerivedData/
*.xcresult/
*.xcresult
*.xcarchive/
*.ipa
*.dSYM/
*.dSYM.zip
Cache.db*
*.log

# Generated by XcodeGen on the Mac. project.yml is the source of truth.
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# Swift Package Manager working files. Package.resolved is committed.
.build/
.swiftpm/

# Playback frameworks, built outside the repo.
*.xcframework/
FinesseDeps/

# Agent workspace, private memory and scratch output.
.aisandbox/
.claude/
memory/
.sandbox.toml
scratch/
tmp/

# Screenshots and captures belong in the gallery, never the repo. App art lives in Assets.xcassets.
gallery/
screenshots/
*.mov
*.mp4

# Editors and the OS.
.DS_Store
*.swp
.vscode/
.idea/
__pycache__/
